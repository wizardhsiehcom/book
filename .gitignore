# MkDocs build output
book/*/html/
# Standalone per-book copies (generated by deliver-book.sh)
dist/
# Legacy incremental-build fingerprints (no longer written)
book/*/.build-hash
.claude/settings.local.json

# macOS metadata
.DS_Store

# Python bytecode
__pycache__/

# Per-book synced assets (generated by sync-assets.sh, source is docs/assets/)
docs/*/assets/

# Font source archives (large, not needed for build)
docs/assets/fonts/*.zip
docs/assets/fonts/GenWanMin2-ttc/

# Source PDFs and other copyrighted materials
data/
/plan/mit-9-35/

# Superseded Scarlet animation drafts and previews
/docs/assets/characters/scarlet-slash/book-keyframe-draw-v1.png
/docs/assets/characters/scarlet-slash/idle-base.webp
/plan/scarlet-draw-homepage-preview.jpg
/plan/scarlet-draw-v1-layers.psd
/plan/scarlet-idle-homepage.webp

playground/
# Vendor JS bundled into each book (tracked in template only)
book/*/mermaid.min.js
!book/template/mermaid.min.js
demos/
